<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds a per-user Windows Installer package (.msi) for the desktop app with Windows' own msi.dll and makecab.exe
       (no WiX needed). Used by .github\workflows\release.yml and the Agentic server's tools\publish-clients.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MsiBuilder</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
  </PropertyGroup>

</Project>
